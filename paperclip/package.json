{
  "name": "paperclip",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build && esbuild src/main.ts --bundle --platform=node --outdir=dist --format=cjs --out-extension:.js=.cjs",
    "build:packages": "pnpm -r run build",
    "build:app": "esbuild src/main.ts --bundle --platform=node --outdir=dist --format=cjs --out-extension:.js=.cjs",
    "start": "node dist/main.cjs",
    "dev": "tsx watch src/main.ts",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:migrate": "pnpm --filter @paperclip/core db:migrate"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@paperclip/agent-adapters": "workspace:*",
    "@paperclip/core": "workspace:*",
    "@paperclip/dashboard": "workspace:*",
    "@paperclip/gateway": "workspace:*",
    "@paperclip/learning": "workspace:*",
    "@paperclip/shared-types": "workspace:*",
    "@paperclip/trading": "workspace:*",
    "dotenv": "^17.4.2",
    "ws": "^8.18.0"
  }
}
